{
  "name": "microservice-deus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "services/*",
    "web"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint:sql": "squawk services/*/migrations/*.sql",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "squawk-cli": "2.70.0",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2"
  }
}
