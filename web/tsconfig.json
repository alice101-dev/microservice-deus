{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["$app/types", "bun", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src", "test", "server", "*"],
  "exclude": ["src/service-worker"]
}
